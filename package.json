{
  "name": "corevex-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "images": "node scripts/images.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",
    "qa:content": "node scripts/content-check.mjs",
    "qa:js": "node scripts/js-budget.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:responsive": "playwright test -c playwright.responsive.config.ts",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "start:test": "cross-env TEST_MODE=true next start -p 3100",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:perf": "playwright test -c playwright.perf.config.ts && node scripts/with-server.mjs node scripts/js-budget.mjs && lhci autorun --config=lighthouserc.cjs && cross-env CV_LH_PRESET=desktop lhci autorun --config=lighthouserc.cjs",
    "test:load": "node scripts/with-server.mjs k6 run tests/load/k6.js",
    "test:seo": "playwright test -c playwright.seo.config.ts && node scripts/with-server.mjs node scripts/content-check.mjs && node scripts/with-server.mjs linkinator http://localhost:3100/ --config linkinator.config.json",
    "test:security": "playwright test -c playwright.security.config.ts && node scripts/secrets-scan.mjs && npm audit --audit-level=high",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e && npm run test:responsive && npm run test:visual && npm run test:a11y && npm run test:seo && npm run test:security && npm run test:perf && npm run test:load",
    "test:screens": "playwright test -c playwright.screens.config.ts && node scripts/contact-sheet.mjs",
    "test:load:autocannon": "node scripts/with-server.mjs node scripts/load-test.mjs all"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@vercel/blob": "^2.8.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@next/bundle-analyzer": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^9.0.0",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "web-vitals": "^6.2.3"
  },
  "overrides": {
    "zod": "^4.6.7",
    "basic-ftp": "^6.2.6"
  }
}
